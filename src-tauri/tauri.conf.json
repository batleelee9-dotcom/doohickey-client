{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doohickey Client",
  "version": "0.2.0",
  "identifier": "dev.quartz.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Doohickey Client",
        "width": 1200,
        "height": 760,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://textures.minecraft.net https://cdn.modrinth.com https://media.forgecdn.net",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzODcwMDVFQTg1MzdDQzUKUldURmZGT29YZ0NIUTIwU2k5NDdnTmJhaGIzNzVjMkRMN25rVWR3dkF3dkpUYlNaRFlQejRMa3AK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "A fast, minimal Minecraft launcher",
    "copyright": "Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
